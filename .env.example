# Modèle des variables d'environnement : copier en .env.local et remplir (ne jamais versionner les vraies valeurs).

# Base de données Neon (PostgreSQL)
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=verify-full

# Better Auth : secret aléatoire (32 octets en base64) et adresse publique du site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console > Google Auth Platform > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (clé « Sending access »)
RESEND_API_KEY=
# Expéditeur une fois le domaine vérifié chez Resend, ex. : Savoirpay <bonjour@savoirpay.com>
EMAIL_FROM=

# Facultatif : envoi par Gmail au lieu de Resend (mot de passe d'application)
GMAIL_USER=
GMAIL_APP_PASSWORD=
